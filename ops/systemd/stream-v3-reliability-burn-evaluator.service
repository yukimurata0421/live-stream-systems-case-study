[Unit]
Description=Evaluate stream_v3 fast feedback and multi-window burn
Wants=network-online.target
After=network-online.target stream-v3-observability-monitor.service

[Service]
Type=oneshot
User=stream-v3
EnvironmentFile=-/etc/default/stream-v3-observability-monitor
Environment=STREAM_V3_REPO_DIR=/opt/stream_v3
Environment=STREAM_RUNTIME_STATE_DIR=/var/lib/stream-v3/observability-monitor
ExecStart=/bin/bash -lc 'cd "$${STREAM_V3_REPO_DIR}" && export PYTHONPATH="$${STREAM_V3_REPO_DIR}/src$${PYTHONPATH:+:$${PYTHONPATH}}" && exec /usr/bin/python3 "$${STREAM_V3_REPO_DIR}/ops/scripts/stream_v3_operational_reliability_rollup.py" --quick --repo-root "$${STREAM_V3_REPO_DIR}" --output "$${STREAM_RUNTIME_STATE_DIR}/operational_reliability_burn_status.json"'
TimeoutStartSec=120
Nice=10

[Install]
WantedBy=multi-user.target
