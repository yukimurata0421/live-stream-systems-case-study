[Unit]
Description=ADS-B Stream-New fast recovery check
After=network-online.target adsb-streamnew-youtube-stream.service
Wants=network-online.target

[Service]
Type=oneshot
User=yuki
Group=yuki
EnvironmentFile=-/srv/stream_v2/.state/env/adsb-streamnew-fast-recovery.env
Environment=WATCHDOG_SYSTEMCTL_USE_SUDO=1
Environment=PYTHONPATH=/srv/stream_v2/src
ExecStart=/srv/stream_v2/venv/bin/python3 /srv/stream_v2/src/watchers/fast_recovery.py
