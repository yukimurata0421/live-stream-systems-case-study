[Unit]
Description=Read-only Twitch thumbnail clock observation on the monitoring host
After=network-online.target stream-v4-twitch-api-collector.service
Wants=network-online.target

[Service]
Type=simple
User=stream-v3-twitch-thumbnail
Group=yuki
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_THREAD_LIMIT=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONPATH=/opt/stream-v3-twitch-thumbnail/current/src
Environment=LD_LIBRARY_PATH=/opt/stream-v3-twitch-thumbnail/current/runtime/lib
ExecStart=/opt/stream-v3-twitch-thumbnail/current/venv/bin/python3 -m stream_v3.twitch_thumbnail_worker --config /etc/stream-v3-twitch-thumbnail/config.json --state-root /var/lib/stream-v3-twitch-thumbnail
StateDirectory=stream-v3-twitch-thumbnail
StateDirectoryMode=0750
RuntimeDirectory=stream-v3-twitch-thumbnail
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=60
TimeoutStopSec=8
KillMode=control-group
Nice=19
CPUWeight=10
CPUQuota=20%
MemoryMax=256M
MemorySwapMax=0
TasksMax=16
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
TemporaryFileSystem=/tmp:rw,size=32M,mode=1777
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
