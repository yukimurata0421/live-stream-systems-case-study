[Unit]
Description=stream_v3 monitoring-plane self-check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stream-v3
Group=stream-v3
EnvironmentFile=-/etc/default/stream-v3-observability-monitor
Environment=STREAM_V3_REPO_DIR=/opt/stream_v3
Environment=STREAM_RUNTIME_STATE_DIR=/var/lib/stream-v3/observability-monitor
Environment=STREAM_V4_SENTINEL_FILE=/var/lib/stream-monitoring-v4/.state/sentinel/k3s-status.json
ExecStart=/bin/bash -lc 'cd "$${STREAM_V3_REPO_DIR}" && export PYTHONPATH="$${STREAM_V3_REPO_DIR}/src$${PYTHONPATH:+:$${PYTHONPATH}}" && exec /usr/bin/python3 "$${STREAM_V3_REPO_DIR}/ops/scripts/stream_v3_monitoring_watchdog.py" --state-file "$${STREAM_RUNTIME_STATE_DIR}/monitoring_watchdog_state.json" --health-snapshot-file "$${STREAM_RUNTIME_STATE_DIR}/health_summary_snapshot.json" --objective-snapshot-file "$${STREAM_RUNTIME_STATE_DIR}/objective_sli_snapshot.json" --monitoring-v4-sentinel-file "$${STREAM_V4_SENTINEL_FILE}" --threshold 3 --cooldown-sec 600 --max-cache-age-sec 600 --max-monitoring-v4-sentinel-age-sec 360'
