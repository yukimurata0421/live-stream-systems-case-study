# Candidate only: not an instruction to activate on a running host.
# Requires exact Dell runtime authorization, pinned image, rollback and shadow verification.
# 600 seconds is the whole recovery verification deadline, not TERM grace.
FR_FFMPEG_FORCE_KILL_ENABLED=1
FR_FFMPEG_TERM_GRACE_SEC=2
FR_FFMPEG_KILL_WAIT_SEC=1
FFMPEG_RW_TIMEOUT_ENABLED=1
FFMPEG_RW_TIMEOUT_USEC=15000000
