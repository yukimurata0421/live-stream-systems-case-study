[Unit]
Description=ADS-B Stream-New YouTube video id resolver cache updater
After=network-online.target adsb-streamnew-youtube-stream.service
Wants=network-online.target

[Service]
Type=oneshot
User=yuki
Group=yuki
EnvironmentFile=-/srv/stream_v2/.state/env/adsb-streamnew-youtube-monitor.env
Environment=PYTHONPATH=/srv/stream_v2/src
ExecStart=/srv/stream_v2/venv/bin/python3 /srv/stream_v2/src/watchers/youtube_video_id_resolver.py
