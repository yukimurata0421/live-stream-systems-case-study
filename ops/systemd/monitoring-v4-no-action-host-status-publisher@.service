[Unit]
Description=Publish signed arena NO_ACTION host status for immutable release %i
StartLimitIntervalSec=10s
StartLimitBurst=10
Wants=monitoring-v4-dell-host-status-pull@%i.service
After=monitoring-v4-cra-projection-server@%i.service monitoring-v4-dell-host-status-pull@%i.service
ConditionPathExists=/opt/stream-monitoring-cra-projection/releases/%i/release_manifest.json
ConditionPathExists=/opt/stream-monitoring-cra-projection/runtimes/%i/runtime_manifest.json
ConditionPathExists=/etc/stream-monitoring-cra-projection/releases/%i/no-action-host-status-publisher.json

[Service]
Type=oneshot
User=stream-monitoring-projection
Group=stream-monitoring-projection
SupplementaryGroups=systemd-journal
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=/opt/stream-monitoring-cra-projection/releases/%i/src
Environment=CRA_IMMUTABLE_RELEASE_ID=%i
ExecStart=/opt/stream-monitoring-cra-projection/runtimes/%i/.venv/bin/python -m cra_no_action_soak.host_status_publisher --config /etc/stream-monitoring-cra-projection/releases/%i/no-action-host-status-publisher.json
TimeoutStartSec=15s
TimeoutStopSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/stream-monitoring-cra-projection/releases/%i /opt/stream-monitoring-cra-projection/runtimes/%i /etc/stream-monitoring-cra-projection/releases/%i
ReadOnlyPaths=/etc/stream-monitoring-cra-projection/credentials/monitoring-ed25519-private.pem /etc/stream-monitoring-cra-projection/credentials/dell-observation-ed25519-public.pem /etc/stream-monitoring-cra-projection/credentials/dell-observation-client.pem
ReadOnlyPaths=/etc/stream-recovery-control/host-contract.json /etc/needrestart/conf.d/stream-recovery-control.conf /var/lib/stream-monitoring-v4
ReadWritePaths=/var/lib/stream-monitoring-v4/cra-projection/releases/%i
InaccessiblePaths=/etc/stream-monitoring-v4/cra-projection-postgres.conninfo /etc/stream-monitoring-cra-projection/credentials/dell-observation-client-key.pem /etc/stream-monitoring-cra-projection/credentials/monitoring-server-key.pem
InaccessiblePaths=/var/lib/stream-recovery-control

# Read-only local fact synthesis and signing. No network or Monitoring database credential is visible.
