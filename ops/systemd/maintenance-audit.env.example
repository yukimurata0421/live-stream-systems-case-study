# P1 audit-only defaults. Enabling or attaching this file to a live unit requires explicit approval.
MAINTENANCE_AUDIT_ENABLED=0
MAINTENANCE_AUDIT_HOST_ID=PROVISION_PROTOCOL_HOST_ID
MAINTENANCE_AUDIT_BIND_SOURCE_TARGET=0
MAINTENANCE_AUDIT_STATE_FILE=/run/stream-recovery-control/maintenance-audit-state.json
MAINTENANCE_AUDIT_EVENT_FILE=/var/lib/stream-recovery-control/audit/maintenance-audit.jsonl
MAINTENANCE_AUDIT_HEALTH_FILE=/var/lib/stream-recovery-control/audit/maintenance-audit-health.json
