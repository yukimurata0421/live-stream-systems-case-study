# systemd EnvironmentFile: reception policy only; no gain, power or retry-cap setting.
AIRSPY_RX_RATE_RATIO=0.10
AIRSPY_RX_BASELINE_SEC=300
AIRSPY_RX_GRACE_SEC=90
AIRSPY_RX_SUSTAIN_SEC=180
AIRSPY_RX_STARTUP_WINDOW_SEC=900
AIRSPY_RX_SAMPLE_MAX_AGE_SEC=90
AIRSPY_RX_READSB_MAX_AGE_SEC=30
AIRSPY_RX_MIN_SAMPLES=3
AIRSPY_RX_BASELINE_MIN_SAMPLES=3
AIRSPY_RX_BASELINE_MIN_POSITIONS=2
AIRSPY_RX_COOLDOWN_SEC=300
