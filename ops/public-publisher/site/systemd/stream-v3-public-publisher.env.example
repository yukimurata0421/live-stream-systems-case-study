# Install as /etc/default/stream-v3-public-publisher on the Raspberry Pi.
# Use an SSH alias or resolvable hostname; do not commit a private address.
YUKIMURATA_GCS_DEST=gs://replace-with-public-destination
STREAM_V3_RELIABILITY_SSH_TARGET=stream-monitor
STREAM_V3_RELIABILITY_SOURCE_DIR=/opt/stream_v3
STREAM_V3_RELIABILITY_STATE_DIR=/var/lib/stream-v3/observability-monitor
STATUS_DIR=/opt/stream-v3-public-publisher/status
