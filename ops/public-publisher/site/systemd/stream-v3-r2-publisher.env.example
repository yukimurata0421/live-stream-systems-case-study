# Add these values to the publisher's external EnvironmentFile.
# The existing variable-name prefix is retained for uploader compatibility.
YUKIMURATA_R2_BUCKET=replace-with-private-public-status-bucket
YUKIMURATA_R2_PREFIX=public/
YUKIMURATA_R2_CREDENTIALS=/etc/stream-v3-public-publisher/cloudflare-r2.env
YUKIMURATA_R2_STATUS_FILE=/var/lib/stream-v3-public-publisher/r2-publication.json

# Optional; leave unset to disable the post-publication health request.
# YUKIMURATA_PUBLICATION_HEALTH_URL=https://status.example.invalid/health/publication

# Existing collection configuration remains in the base EnvironmentFile.
STREAM_V3_EGRESS_SSH_TARGET=stream-monitor
