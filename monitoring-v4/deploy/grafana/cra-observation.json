      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Unconfirmed notification deliveries",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cra_notification_unconfirmed{job=\"cra_observation\"}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Agent and Central audit watermarks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cra_agent_audit_sequence{job=\"cra_observation\"}",
          "legendFormat": "agent"
        },
        {
          "refId": "B",
          "expr": "cra_central_audit_sequence{job=\"cra_observation\"}",
          "legendFormat": "central"
        }
      ]
    },
    {
      "id": 10,
      "title": "Pod API request duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cra_pod_api_last_request_duration_seconds{job=\"cra_observation\"}",
          "legendFormat": "request duration"
        }
      ]
    },
    {
      "id": 11,
      "title": "CRA audit and observation log",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"cra\",source=\"cra_monitoring\"}",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "description": "Read-only monitoring of CRA. Decisions, budgets and execution remain owned by CRA and the existing Executor. Log source_ts_utc preserves source event time; ts_utc is projection time."
}
