{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monitoring_v4.incident_transition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transition_id", "episode_id", "domain", "phase", "severity", "occurred_at", "current_snapshot_id", "summary", "reason_codes"],
  "properties": {
    "schema": {"const": "monitoring_v4.incident_transition.v1"},
    "transition_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,47}:[0-9a-f]{24,64}$"},
    "episode_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,47}:[0-9a-f]{24,64}$"},
    "domain": {"type": "string"},
    "phase": {"enum": ["detected", "repeat", "recovered"]},
    "severity": {"enum": ["info", "warning", "critical"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "current_snapshot_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,47}:[0-9a-f]{24,64}$"},
    "summary": {"type": "string"},
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  }
}
