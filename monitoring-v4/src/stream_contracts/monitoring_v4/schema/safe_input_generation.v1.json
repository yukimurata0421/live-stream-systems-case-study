{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monitoring_v4.safe_input_generation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generation_id", "source_revision", "files"],
  "properties": {
    "schema": {"const": "monitoring_v4.safe_input_generation.v1"},
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 200},
    "files": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 12,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size_bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 20971520}
        }
      }
    }
  }
}
