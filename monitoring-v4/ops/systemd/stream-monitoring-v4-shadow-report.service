[Unit]
Description=Build Monitoring v4 revision-pinned shadow evidence report
After=local-fs.target
ConditionPathExists=/var/lib/stream-monitoring-v4/.state/monitoring-v4-shadow.sqlite3

[Service]
Type=oneshot
User=streamv4
Group=streamv4
WorkingDirectory=/opt/stream-v4/releases/current
Environment=PYTHONPATH=/opt/stream-v4/releases/current/src
Environment=STREAM_V4_BUILD_REVISION=unversioned
EnvironmentFile=-/var/lib/stream-monitoring-v4/.state/deployed-revision.env
ExecStart=/usr/bin/python3 -m stream_monitoring_v4.commands.shadow_report --db /var/lib/stream-monitoring-v4/.state/monitoring-v4-shadow.sqlite3 --build-revision=${STREAM_V4_BUILD_REVISION} --source-revision-file /srv/stream-v3/.state/arena-monitor/deployed-revision.env --output /var/lib/stream-monitoring-v4/.state/shadow-evidence-report.json
TimeoutStartSec=45
UMask=0077
Nice=10
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadOnlyPaths=/opt/stream-v4/releases
ReadWritePaths=/var/lib/stream-monitoring-v4/.state
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
