{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stream-recovery-control.local/runtime.typed_effect_request.v3.schema.json",
  "title": "Typed Manual Stream Route Request v3",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "producer_id",
    "producer_generation",
    "intent_type",
    "reason",
    "failure_domain",
    "issued_at",
    "expires_at",
    "ffmpeg_target_identity",
    "runtime_identity",
    "expected_ffmpeg_generation",
    "idempotency_key",
    "correlation_id",
    "target_snapshot_id",
    "runtime_snapshot_id",
    "runtime_observation_id",
    "expected_executor_instance_id",
    "maintenance_evidence_status",
    "projection_id",
    "projection_sequence",
    "route_transition"
  ],
  "properties": {
    "schema_version": {
      "const": "runtime.typed_effect_request.v3"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_generation": {
      "type": "integer",
      "minimum": 1
    },
    "intent_type": {
      "const": "SWITCH_STREAM_ROUTE"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "failure_domain": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "ffmpeg_target_identity": {
      "$ref": "#/$defs/ffmpegTarget"
    },
    "runtime_identity": {
      "type": "null"
    },
    "expected_ffmpeg_generation": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "target_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_snapshot_id": {
      "const": ""
    },
    "runtime_observation_id": {
      "type": "string"
    },
    "expected_executor_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "maintenance_evidence_status": {
      "enum": [
        "AVAILABLE",
        "UNKNOWN",
        "STALE",
        "INVALID"
      ]
    },
    "projection_id": {
      "type": "string"
    },
    "projection_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "route_transition": {
      "type": "object",
      "required": [
        "from_route",
        "to_route",
        "expected_route_generation",
        "operator_grant_id"
      ],
      "properties": {
        "from_route": {
          "enum": [
            "PRIMARY",
            "FALLBACK"
          ]
        },
        "to_route": {
          "enum": [
            "PRIMARY",
            "FALLBACK"
          ]
        },
        "expected_route_generation": {
          "type": "integer",
          "minimum": 1
        },
        "operator_grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "oneOf": [
        {
          "properties": {
            "from_route": {
              "const": "PRIMARY"
            },
            "to_route": {
              "const": "FALLBACK"
            }
          }
        },
        {
          "properties": {
            "from_route": {
              "const": "FALLBACK"
            },
            "to_route": {
              "const": "PRIMARY"
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "ffmpegTarget": {
      "type": "object",
      "required": [
        "host_id",
        "host_boot_id",
        "namespace",
        "pod_uid",
        "container_name",
        "container_id",
        "ffmpeg_generation",
        "ffmpeg_pid"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1
        },
        "host_boot_id": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "pod_uid": {
          "type": "string",
          "minLength": 1
        },
        "container_name": {
          "const": "stream-engine"
        },
        "container_id": {
          "type": "string",
          "minLength": 1
        },
        "ffmpeg_generation": {
          "type": "string",
          "minLength": 1
        },
        "ffmpeg_pid": {
          "type": "integer",
          "minimum": 2
        }
      },
      "additionalProperties": false
    },
    "runtimeIdentity": {
      "type": "object",
      "required": [
        "host_id",
        "host_boot_id",
        "namespace",
        "pod_uid",
        "stream_engine_container_name",
        "stream_engine_container_id",
        "runtime_generation"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1
        },
        "host_boot_id": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "pod_uid": {
          "type": "string",
          "minLength": 1
        },
        "stream_engine_container_name": {
          "const": "stream-engine"
        },
        "stream_engine_container_id": {
          "type": "string",
          "pattern": "^containerd://"
        },
        "runtime_generation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [],
  "additionalProperties": false
}
