{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cra_dell_recovery.local_action_journal_page.v1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "message_type", "request_id", "reconciliation_id", "target_id", "after_sequence", "page_limit", "issued_at", "expires_at", "key_id", "payload_sha256", "signature"],
      "properties": {
        "protocol": {"const": "cra_dell_recovery.local_action_journal_page.v1"},
        "message_type": {"const": "local_action_journal_page_request"},
        "request_id": {"$ref": "#/$defs/id"},
        "reconciliation_id": {"$ref": "#/$defs/id"},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "after_sequence": {"type": "integer", "minimum": 0},
        "page_limit": {"type": "integer", "minimum": 1, "maximum": 200},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "key_id": {"$ref": "#/$defs/id"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "minLength": 40, "maxLength": 200}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "message_type", "page_id", "request_id", "reconciliation_id", "target_id", "agent_installation_id", "after_sequence", "records", "journal_high_water", "journal_high_digest", "has_more", "issued_at", "expires_at", "key_id", "payload_sha256", "signature"],
      "properties": {
        "protocol": {"const": "cra_dell_recovery.local_action_journal_page.v1"},
        "message_type": {"const": "local_action_journal_page"},
        "page_id": {"$ref": "#/$defs/id"},
        "request_id": {"$ref": "#/$defs/id"},
        "reconciliation_id": {"$ref": "#/$defs/id"},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "agent_installation_id": {"$ref": "#/$defs/id"},
        "after_sequence": {"type": "integer", "minimum": 0},
        "records": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/journal_record"}},
        "journal_high_water": {"type": "integer", "minimum": 0},
        "journal_high_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "has_more": {"type": "boolean"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "key_id": {"$ref": "#/$defs/id"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "minLength": 40, "maxLength": 200}
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,239}$"},
    "target_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["host_id", "host_boot_id", "namespace", "pod_uid", "container_name", "container_id", "ffmpeg_generation", "ffmpeg_pid"],
      "properties": {
        "host_id": {"type": "string", "minLength": 1}, "host_boot_id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1}, "pod_uid": {"type": "string", "minLength": 1},
        "container_name": {"const": "stream-engine"}, "container_id": {"type": "string", "minLength": 1},
        "ffmpeg_generation": {"type": "string", "minLength": 1}, "ffmpeg_pid": {"type": "integer", "minimum": 2}
      }
    },
    "journal_record": {
      "type": "object", "additionalProperties": false,
      "required": ["journal_sequence", "local_action_id", "local_session_id", "target_id", "effect_scope_id", "record_state", "physical_attempt_count", "before_target", "after_target", "evidence_digest", "reason_code", "recorded_at", "previous_digest", "record_digest"],
      "properties": {
        "journal_sequence": {"type": "integer", "minimum": 1},
        "local_action_id": {"$ref": "#/$defs/id"},
        "local_session_id": {"$ref": "#/$defs/id"},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "effect_scope_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_state": {"enum": ["EXECUTION_STARTED", "EFFECT_BOUNDARY_REACHED", "EFFECT_OBSERVED", "EFFECT_FAILED", "OUTCOME_UNKNOWN"]},
        "physical_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "before_target": {"$ref": "#/$defs/target_identity"},
        "after_target": {"anyOf": [{"$ref": "#/$defs/target_identity"}, {"type": "null"}]},
        "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reason_code": {"$ref": "#/$defs/id"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "previous_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
