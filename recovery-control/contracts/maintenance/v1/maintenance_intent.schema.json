{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maintenance.transaction.intent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "maintenance_id",
    "request_id",
    "requested_at",
    "requested_by",
    "target_id",
    "target_identity",
    "authority_epoch",
    "authority_session_id",
    "maintenance_generation",
    "reason",
    "state"
  ],
  "properties": {
    "protocol": {"const": "maintenance.transaction.intent.v1"},
    "maintenance_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "requested_at": {"type": "string", "format": "date-time"},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_identity": {"$ref": "#/$defs/target_identity"},
    "authority_epoch": {"type": "integer", "minimum": 1},
    "authority_session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "maintenance_generation": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "state": {"const": "REQUESTED"}
  },
  "$defs": {
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "host_boot_id", "namespace", "pod_uid", "container_name", "container_id", "ffmpeg_generation", "ffmpeg_pid"],
      "properties": {
        "host_id": {"type": "string", "minLength": 1},
        "host_boot_id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "pod_uid": {"type": "string", "minLength": 1},
        "container_name": {"const": "stream-engine"},
        "container_id": {"type": "string", "minLength": 1},
        "ffmpeg_generation": {"type": "string", "minLength": 1},
        "ffmpeg_pid": {"type": "integer", "minimum": 2}
      }
    }
  }
}
