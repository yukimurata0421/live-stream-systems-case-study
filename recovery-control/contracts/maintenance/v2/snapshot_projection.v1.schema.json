{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yukimurata0421.dev/contracts/maintenance/snapshot_projection.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "projection_sequence",
    "producer_id",
    "producer_instance_id",
    "published_at",
    "fresh_until",
    "source_snapshot_id",
    "source_producer_id",
    "source_producer_instance_id",
    "source_observed_at",
    "source_fresh_until",
    "maintenance_generation",
    "target_snapshot_id",
    "target_snapshot_status",
    "payload",
    "payload_sha256",
    "production_behavior_modified",
    "physical_effect_count"
  ],
  "properties": {
    "schema_version": {"const": "maintenance.snapshot_projection.v1"},
    "projection_id": {"type": "string", "minLength": 1},
    "projection_sequence": {"type": "integer", "minimum": 1},
    "producer_id": {"type": "string", "minLength": 1},
    "producer_instance_id": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "fresh_until": {"type": "string", "format": "date-time"},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "source_producer_id": {"type": "string", "minLength": 1},
    "source_producer_instance_id": {"type": "string", "minLength": 1},
    "source_observed_at": {"type": "string", "format": "date-time"},
    "source_fresh_until": {"type": "string", "format": "date-time"},
    "maintenance_generation": {"type": "integer", "minimum": 0},
    "target_snapshot_id": {"type": "string"},
    "target_snapshot_status": {"type": "string"},
    "payload": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "production_behavior_modified": {"const": false},
    "physical_effect_count": {"const": 0}
  }
}
