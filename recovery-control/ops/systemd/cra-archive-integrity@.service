[Unit]
Description=Read-only CRA archive integrity check for immutable release %i
After=local-fs.target
ConditionPathExists=/opt/stream-recovery-control/releases/%i/release_manifest.json
ConditionPathExists=/opt/stream-recovery-control/runtimes/%i/runtime_manifest.json
ConditionPathExists=/etc/stream-recovery-control/releases/%i/archive-integrity.json

[Service]
Type=oneshot
User=stream-recovery
Group=stream-recovery
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=/opt/stream-recovery-control/releases/%i/src
Environment=CRA_IMMUTABLE_RELEASE_ID=%i
Environment=LD_LIBRARY_PATH=/opt/stream-recovery-control/runtimes/%i/sqlite/lib
ExecStart=/opt/stream-recovery-control/runtimes/%i/.venv/bin/python -m cra_authority.archive_integrity --config /etc/stream-recovery-control/releases/%i/archive-integrity.json
TimeoutStartSec=15min
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/stream-recovery-control/releases/%i /opt/stream-recovery-control/releases/%i /opt/stream-recovery-control/runtimes/%i /var/lib/stream-recovery-control/cra/archive
ReadWritePaths=/var/lib/stream-recovery-control/cra/releases/%i
InaccessiblePaths=/etc/stream-recovery-control/cra-archive-signing-private.pem /etc/stream-recovery-control/cra-monitoring-client-key.pem

# This process has no signing key, network socket, command delivery path, or Effect Executor credential.
