/var/lib/stream-recovery-control/cra/p1-live/*.jsonl {
    daily
    rotate 14
    maxsize 10M
    compress
    delaycompress
    missingok
    notifempty
    create 0600 stream-recovery stream-recovery
    su stream-recovery stream-recovery
}

/var/lib/stream-v3/p1-audit/*.jsonl {
    daily
    rotate 14
    maxsize 10M
    compress
    delaycompress
    missingok
    notifempty
    create 0600 yuki yuki
    su yuki yuki
}
