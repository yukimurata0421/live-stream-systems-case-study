# Optional FIFO profile; test with the complete AV command before deployment.
RTMP_FIFO_RECOVERY=1
RTMP_FIFO_QUEUE_SIZE=32
RTMP_FIFO_RECOVERY_WAIT_SEC=0.2
RTMP_FIFO_MAX_RECOVERY_ATTEMPTS=20
RTMP_FIFO_DROP_PKTS_ON_OVERFLOW=1
RTMP_FIFO_RESTART_WITH_KEYFRAME=1
FFMPEG_RW_TIMEOUT_ENABLED=1
FFMPEG_RW_TIMEOUT_USEC=3000000
# Use an explicitly mounted persistent directory for events.
STREAM_FIFO_TELEMETRY_JOURNAL_DIR=/var/lib/stream-demo/fifo-transport
