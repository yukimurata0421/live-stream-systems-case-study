APP_ENV=production
BASE_DIR=/home/yuki/projects/stream_v2
STREAM_KEY=REPLACE_ME
RTMP_URL=rtmps://a.rtmps.youtube.com:443/live2

# Keep these aligned with validated live settings.
FRAME_RATE=5
VIDEO_BITRATE=3400k
VIDEO_MAXRATE=3400k
VIDEO_BUFSIZE=6800k
AUDIO_BITRATE=192k
AUDIO_SAMPLE_RATE=48000
AUDIO_FILTER=aresample=async=1:min_hard_comp=0.030000:first_pts=0,volume=0.25

TAKEOVER_ENABLED=1
TAKEOVER_GRACE_SEC=5
TAKEOVER_FORCE_KILL=1

NOW_PLAYING_FILE=/home/yuki/projects/stream_v2/now_playing.txt
OVERLAY_DIR=/home/yuki/projects/stream_v2/ui/overlay
OVERLAY_MAP_PATH=adsb-map/
PRECIPITATION_ENABLED=1
PRECIPITATION_ROOT=/home/yuki/projects/stream_v3/.state/overlay/precipitation
PRECIPITATION_POLL_SEC=300
PRECIPITATION_PUBLISH_DELAY_SEC=25
PRECIPITATION_RETRY_DELAYS_SEC=15,45,120
PRECIPITATION_STALE_SEC=900
PRECIPITATION_TIMEOUT_SEC=20
PRECIPITATION_TILE_ZOOMS=6
PRECIPITATION_BOUNDS=133.79165750178356,33.13454570645014,147.70834249821644,39.43795428878076
JMA_NOWC_METADATA_URL=https://www.jma.go.jp/bosai/jmatile/data/nowc/targetTimes_N1.json
JMA_NOWC_DATA_ROOT_URL=https://www.jma.go.jp/bosai/jmatile/data/nowc
PRE_FFMPEG_OVERLAY_READY_TIMEOUT_SEC=20
PRE_FFMPEG_OVERLAY_READY_POLL_SEC=0.5
PRE_FFMPEG_REQUIRE_OVERLAY_READY=0
RUNTIME_STATE_FILE=/home/yuki/projects/stream_v2/state/runtime/stream_runtime_state.json
