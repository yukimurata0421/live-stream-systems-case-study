# Copy to ~/.config/stream-v3/matched-player.env and set the local values.
# Use literal values with no quotes, shell substitutions, or credentials.
PLAYER_VIDEO_ID=REPLACE_WITH_PUBLIC_VIDEO_ID
PLAYER_ARTIFACT=/path/to/verified/public-player-probe
PLAYER_ARTIFACT_SHA256=REPLACE_WITH_ARTIFACT_SHA256
PLAYER_PLAYWRIGHT_SITE=/path/to/venv/lib/python3.14/site-packages
PLAYER_PILLOW_SITE=/path/to/pillow/site-packages
PLAYER_OCR_ROOT=/path/to/tesseract-root
PLAYER_OUTPUT_ROOT=/path/to/existing/private-evidence-directory
