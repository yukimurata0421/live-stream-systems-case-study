{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cra_dell_recovery.agent_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "message_type", "state_id", "agent_id", "agent_installation_id",
    "target_id", "authority_state", "highest_authority_epoch_seen",
    "highest_command_seq_consumed", "active_authority_session_id", "target_identity",
    "unresolved_command_ids", "observed_at", "key_id", "payload_sha256", "signature"
  ],
  "properties": {
    "protocol": {"const": "cra_dell_recovery.agent_state.v1"},
    "message_type": {"const": "agent_state"},
    "state_id": {"$ref": "#/$defs/id"},
    "agent_id": {"$ref": "#/$defs/id"},
    "agent_installation_id": {"$ref": "#/$defs/id"},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "authority_state": {"type": "string", "minLength": 1, "maxLength": 80},
    "highest_authority_epoch_seen": {"type": "integer", "minimum": 0},
    "highest_command_seq_consumed": {"type": "integer", "minimum": 0},
    "active_authority_session_id": {"type": ["string", "null"], "maxLength": 240},
    "target_identity": {"anyOf": [{"$ref": "#/$defs/target_identity"}, {"type": "null"}]},
    "unresolved_command_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "observed_at": {"type": "string", "format": "date-time"},
    "key_id": {"$ref": "#/$defs/id"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 40, "maxLength": 200}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,239}$"},
    "target_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["host_id", "host_boot_id", "namespace", "pod_uid", "container_name", "container_id", "ffmpeg_generation", "ffmpeg_pid"],
      "properties": {
        "host_id": {"type": "string", "minLength": 1}, "host_boot_id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1}, "pod_uid": {"type": "string", "minLength": 1},
        "container_name": {"const": "stream-engine"}, "container_id": {"type": "string", "minLength": 1},
        "ffmpeg_generation": {"type": "string", "minLength": 1}, "ffmpeg_pid": {"type": "integer", "minimum": 2}
      }
    }
  }
}
