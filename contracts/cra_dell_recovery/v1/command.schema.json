{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cra_dell_recovery.command.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "message_type", "message_id", "sender_id", "receiver_id",
    "controller_instance_id", "authority_session_id", "authority_epoch",
    "command_seq", "command_id", "idempotency_key", "incident_id",
    "authorization_id", "policy_revision", "action", "reason_code", "target",
    "expected_target", "decision", "verification_contract", "issued_at",
    "expires_at", "key_id", "payload_sha256", "signature"
  ],
  "properties": {
    "protocol": {"const": "cra_dell_recovery.command.v1"},
    "message_type": {"const": "execute_command"},
    "message_id": {"$ref": "#/$defs/id"},
    "sender_id": {"$ref": "#/$defs/id"},
    "receiver_id": {"$ref": "#/$defs/id"},
    "controller_instance_id": {"$ref": "#/$defs/id"},
    "authority_session_id": {"$ref": "#/$defs/id"},
    "authority_epoch": {"type": "integer", "minimum": 1},
    "command_seq": {"type": "integer", "minimum": 1},
    "command_id": {"$ref": "#/$defs/id"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 240},
    "incident_id": {"$ref": "#/$defs/id"},
    "authorization_id": {"$ref": "#/$defs/id"},
    "policy_revision": {"type": "string", "minLength": 1, "maxLength": 200},
    "action": {"const": "restart_ffmpeg"},
    "reason_code": {"const": "confirmed_tcp_stall"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "host_id", "namespace", "workload", "container_name"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "host_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "namespace": {"type": "string", "minLength": 1, "maxLength": 200},
        "workload": {"type": "string", "minLength": 1, "maxLength": 240},
        "container_name": {"const": "stream-engine"}
      }
    },
    "expected_target": {"$ref": "#/$defs/target_identity"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_cycle_id", "observed_at", "confirmed_at", "evidence_fresh_until"],
      "properties": {
        "decision_cycle_id": {"$ref": "#/$defs/id"},
        "observed_at": {"type": "string", "format": "date-time"},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "evidence_fresh_until": {"type": "string", "format": "date-time"}
      }
    },
    "verification_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_new_ffmpeg_generation", "require_same_host_boot_id", "require_same_pod_uid", "health_owner"],
      "properties": {
        "required_new_ffmpeg_generation": {"const": true},
        "require_same_host_boot_id": {"const": true},
        "require_same_pod_uid": {"const": true},
        "health_owner": {"const": "monitoring-v4"}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "key_id": {"$ref": "#/$defs/id"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 40, "maxLength": 200}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,239}$"},
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "host_boot_id", "namespace", "pod_uid", "container_name", "container_id", "ffmpeg_generation", "ffmpeg_pid"],
      "properties": {
        "host_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "host_boot_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "namespace": {"type": "string", "minLength": 1, "maxLength": 200},
        "pod_uid": {"type": "string", "minLength": 1, "maxLength": 200},
        "container_name": {"const": "stream-engine"},
        "container_id": {"type": "string", "minLength": 1, "maxLength": 300},
        "ffmpeg_generation": {"type": "string", "minLength": 1, "maxLength": 300},
        "ffmpeg_pid": {"type": "integer", "minimum": 2}
      }
    }
  }
}
