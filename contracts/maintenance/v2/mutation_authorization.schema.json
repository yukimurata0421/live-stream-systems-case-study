{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maintenance.mutation_authorization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "authorization_kind",
    "authorization_id",
    "maintenance_id",
    "maintenance_generation",
    "executor_id",
    "operation",
    "resource_identity",
    "source_target_identity",
    "expected_target_change",
    "issued_authority_epoch",
    "issued_authority_session_id",
    "issued_at",
    "expires_at",
    "sequence",
    "nonce",
    "operation_digest",
    "single_use"
  ],
  "properties": {
    "protocol": {"const": "maintenance.mutation_authorization.v1"},
    "authorization_kind": {"const": "MAINTENANCE_MUTATION"},
    "authorization_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "maintenance_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "maintenance_generation": {"type": "integer", "minimum": 1},
    "executor_id": {"enum": ["planned_rollout_executor", "manual_planned_executor"]},
    "operation": {"const": "restart_deployment"},
    "resource_identity": {"const": "deployment/stream-v3/stream-v3-runtime"},
    "source_target_identity": {"$ref": "#/$defs/target_identity"},
    "expected_target_change": {"const": "replace_pod_and_ffmpeg_generation"},
    "issued_authority_epoch": {"type": "integer", "minimum": 1},
    "issued_authority_session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 128},
    "operation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "single_use": {"const": true}
  },
  "$defs": {
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "host_boot_id",
        "namespace",
        "pod_uid",
        "container_name",
        "container_id",
        "ffmpeg_generation",
        "ffmpeg_pid"
      ],
      "properties": {
        "host_id": {"type": "string", "minLength": 1},
        "host_boot_id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "pod_uid": {"type": "string", "minLength": 1},
        "container_name": {"const": "stream-engine"},
        "container_id": {"type": "string", "minLength": 1},
        "ffmpeg_generation": {"type": "string", "minLength": 1},
        "ffmpeg_pid": {"type": "integer", "minimum": 2}
      }
    }
  }
}
