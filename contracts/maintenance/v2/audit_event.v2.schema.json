{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maintenance.audit_event.v2",
  "type": "object",
  "required": [
    "schema_version", "timestamp", "event_id", "host", "host_id", "host_boot_id", "os_hostname",
    "process_instance_id", "process_id", "thread_id", "monotonic_ns", "process_service", "path_id",
    "phase", "operation", "path_role", "resource_identity", "correlation_id",
    "correlation_owner_path_id", "target_identity", "operation_generation",
    "maintenance_observed_state", "maintenance_snapshot_observed_at", "maintenance_snapshot_fresh_until",
    "maintenance_snapshot_id", "maintenance_producer_id", "maintenance_producer_instance_id",
    "maintenance_id", "maintenance_generation", "authority_epoch", "authority_session_id",
    "source_target_identity", "target_snapshot_id", "target_snapshot_status", "target_snapshot_age", "target_snapshot_age_seconds",
    "authorization_id", "in_flight_evidence", "generation_evidence", "audit_verdict", "audit_reason",
    "audit_hook_latency_us", "queue_depth_before", "queue_capacity", "production_behavior_modified"
  ],
  "properties": {
    "schema_version": {"const": "maintenance.audit_event.v2"},
    "timestamp": {"type": "string", "format": "date-time"},
    "event_id": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "host_boot_id": {"type": "string", "minLength": 1},
    "os_hostname": {"type": "string", "minLength": 1},
    "process_instance_id": {"type": "string", "minLength": 1},
    "process_id": {"type": "integer", "minimum": 1},
    "thread_id": {"type": "integer", "minimum": 1},
    "monotonic_ns": {"type": "integer", "minimum": 1},
    "process_service": {"type": "string", "minLength": 1},
    "path_id": {"pattern": "^MP-[0-9]{2}$"},
    "phase": {"enum": ["OBSERVATION", "ACTION_PLAN_CREATED", "ADMISSION", "EFFECT_BOUNDARY", "EFFECT_RETURNED", "QUIESCE_ACK", "RELEASE_ACK"]},
    "operation": {"type": "string", "minLength": 1},
    "path_role": {"type": "string", "minLength": 1},
    "resource_identity": {"type": "string"},
    "correlation_id": {"type": "string", "minLength": 1},
    "correlation_owner_path_id": {"type": "string"},
    "native_operation_id": {"type": "string"},
    "native_operation_generation": {"type": "string"},
    "target_identity": {"type": ["object", "null"]},
    "operation_generation": {"type": ["integer", "null"], "minimum": 1},
    "maintenance_observed_state": {"type": "string", "minLength": 1},
    "maintenance_snapshot_observed_at": {"type": "string", "minLength": 1},
    "maintenance_snapshot_fresh_until": {"type": "string", "minLength": 1},
    "maintenance_snapshot_id": {"type": "string"},
    "maintenance_producer_id": {"type": "string"},
    "maintenance_producer_instance_id": {"type": "string"},
    "maintenance_projection_id": {"type": "string", "minLength": 1},
    "maintenance_projection_sequence": {"type": "integer", "minimum": 1},
    "maintenance_projection_reason": {"type": "string", "minLength": 1},
    "maintenance_id": {"type": "string"},
    "maintenance_generation": {"type": "integer", "minimum": 0},
    "authority_epoch": {"type": "integer", "minimum": 0},
    "authority_session_id": {"type": "string"},
    "source_target_identity": {"type": ["object", "null"]},
    "target_snapshot_id": {"type": "string"},
    "target_snapshot_status": {"type": "string"},
    "target_snapshot_age_seconds": {"type": ["number", "null"]},
    "target_snapshot_age": {"type": ["number", "null"]},
    "authorization_id": {"type": "string"},
    "in_flight_evidence": {"type": "object"},
    "generation_evidence": {"type": "object"},
    "audit_verdict": {"enum": ["WOULD_ALLOW", "WOULD_BLOCK", "WOULD_ACK", "WOULD_REJECT", "UNKNOWN", "NOT_APPLICABLE"]},
    "audit_reason": {"type": "string", "minLength": 1},
    "audit_hook_latency_us": {"type": "number", "minimum": 0},
    "queue_depth_before": {"type": "integer", "minimum": 0},
    "queue_capacity": {"type": "integer", "minimum": 1},
    "actual_production_decision": {"type": "string"},
    "actual_production_result": {"type": "string"},
    "p2_disabled_evaluation_requested": {"type": "boolean"},
    "p2_disabled_verdict": {"enum": ["NOT_EVALUATED", "UNKNOWN", "ALLOW", "BLOCK", "ACK", "REJECT", "NOT_APPLICABLE"]},
    "p2_disabled_reason": {"type": "string", "minLength": 1},
    "p2_enforcement_enabled": {"const": false},
    "p2_production_branch_signal": {"type": ["boolean", "null"]},
    "p2_production_adapter_connected": {"const": false},
    "p2_production_behavior_modified": {"const": false},
    "p2_physical_effect_count": {"const": 0},
    "p2_effect_boundary_revalidated": {"type": "boolean"},
    "production_behavior_modified": {"const": false}
  },
  "additionalProperties": false
}
