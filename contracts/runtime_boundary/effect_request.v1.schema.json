{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stream-recovery-control.local/runtime.effect_request.v1.schema.json",
  "title": "Runtime Effect Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "producer_id",
    "producer_generation",
    "operation",
    "reason",
    "issued_at",
    "expires_at",
    "target_identity",
    "expected_ffmpeg_generation",
    "idempotency_key",
    "correlation_id",
    "target_snapshot_id",
    "runtime_observation_id",
    "expected_executor_instance_id",
    "maintenance_evidence_status",
    "projection_id",
    "projection_sequence"
  ],
  "properties": {
    "schema_version": {"const": "runtime.effect_request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "producer_id": {"type": "string", "minLength": 1},
    "producer_generation": {"type": "integer", "minimum": 1},
    "operation": {"const": "restart_ffmpeg"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "target_identity": {"$ref": "#/$defs/targetIdentity"},
    "expected_ffmpeg_generation": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "target_snapshot_id": {"type": "string", "minLength": 1},
    "runtime_observation_id": {"type": "string", "minLength": 1},
    "expected_executor_instance_id": {"type": "string", "minLength": 1},
    "maintenance_evidence_status": {"enum": ["AVAILABLE", "UNKNOWN", "STALE", "INVALID"]},
    "projection_id": {"type": "string"},
    "projection_sequence": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "targetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "host_boot_id",
        "namespace",
        "pod_uid",
        "container_name",
        "container_id",
        "ffmpeg_generation",
        "ffmpeg_pid"
      ],
      "properties": {
        "host_id": {"type": "string", "minLength": 1},
        "host_boot_id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "pod_uid": {"type": "string", "minLength": 1},
        "container_name": {"const": "stream-engine"},
        "container_id": {"type": "string", "minLength": 1},
        "ffmpeg_generation": {"type": "string", "minLength": 1},
        "ffmpeg_pid": {"type": "integer", "minimum": 2}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"maintenance_evidence_status": {"const": "AVAILABLE"}}},
      "then": {
        "properties": {
          "projection_id": {"minLength": 1},
          "projection_sequence": {"minimum": 1}
        }
      }
    }
  ]
}
